import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# Load data
df = pd.read_csv("twitchdata-update.csv")

# Descriptive stats
print(df.describe())

# Correlation matrix
corr = df.corr()
sns.heatmap(corr, annot=True)
plt.show()

# Distribution plots
sns.histplot(df['Watch time (Minutes)'])
plt.show()