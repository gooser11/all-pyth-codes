import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# Load data
df = pd.read_csv("twitchdata-update.csv")

# Convert boolean columns to numeric (1/0)
df['Partnered'] = df['Partnered'].astype(int)
df['Mature'] = df['Mature'].astype(int)

# Drop non-numeric columns (Language is categorical, exclude for now)
numeric_df = df.select_dtypes(include=['int64', 'float64'])

# Compute correlation matrix
corr = numeric_df.corr()

# Plot heatmap
plt.figure(figsize=(10, 8))
sns.heatmap(corr, annot=True, cmap='coolwarm', fmt=".2f")
plt.title("Correlation Matrix (Numeric Variables)")
plt.show()